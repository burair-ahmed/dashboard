//@version=6
// GEX Levels Pro v15 — SPY plan from @PJtrader_17, Tue Nov 17 2026 (ITMatrixHQ GEX)
// Daily update: Settings > Inputs > Levels  ->  price | type | GEX (M, optional) | description
// type: R resistance · S support · K key trigger · T target · X reject zone
indicator("GEX Levels Pro", "GEX Pro", overlay = true, max_lines_count = 200, max_labels_count = 300, max_boxes_count = 100)

string DEFAULT = "750|R|16.01|Major +GEX wall · Bull T5\n748|R||Bull T4\n746|R|13.07|Upper +GEX\n745|R||Bull T3\n743|R||Bull T2 · above = continuation\n740|X||Bull T1 · reject zone top\n739|K|11.5|BULL TRIGGER (reclaim & hold)\n737|K||BEAR TRIGGER (lose it)\n735|S|-2.00|Lower gamma · Bear T1\n733|S|-6.05|Key -GEX · Bear T2 · vol below\n730|S||Bear T3\n725|S||Bear T4\nNET|1.98\nHV|733\nREJ|739|740"

// ═════════ INPUTS ═════════
gL = "① Levels"
levelsTxt = input.text_area(DEFAULT, "Levels  (price | type | GEX M | description)", group = gL, tooltip = "One per line. type: R resistance, S support, K key trigger, T target, X reject zone. GEX in millions (blank = none). Extra lines: NET|22.69 = Net GEX, HV|730 = high-vol level. The two K lines set the bull (upper) and bear (lower) triggers automatically.")
mult      = input.float(1.0, "Price multiplier (1 = SPY, ~10 = SPX)", step = 0.01, group = gL)
netGex    = input.float(22.69, "Fallback Net GEX (M) — used only if no NET line", group = gL)
bullTrig  = input.float(737, "Fallback bull trigger — used only if no K lines", group = gL)
bearTrig  = input.float(733, "Fallback bear trigger — used only if no K lines", group = gL)
volTrig   = input.float(730, "Fallback high-vol level — used only if no HV line", group = gL)

gLn = "② Lines"
lw        = input.int(2, "Level line width", minval = 1, maxval = 6, group = gLn)
lwKey     = input.int(3, "Trigger line width", minval = 1, maxval = 6, group = gLn)
lStyleIn  = input.string("Solid", "Line style", options = ["Solid", "Dashed", "Dotted"], group = gLn)
lTransp   = input.int(0, "Line transparency % (0 = strongest)", minval = 0, maxval = 90, group = gLn)
hitFade   = input.int(35, "Fade for hit targets % (0 = no fade)", minval = 0, maxval = 90, group = gLn)
fadeMax   = input.int(25, "Fade for weak GEX levels %", minval = 0, maxval = 90, group = gLn)
startMode = input.string("Pre-market (4:00 AM ET)", "Lines start at", options = ["Pre-market (4:00 AM ET)", "Today 9:30 open", "Full history"], group = gLn)
lineEnd   = input.int(25, "Line end (bars right of price)", minval = 1, group = gLn)

gT = "③ Text & GEX bars"
txtSizeIn   = input.string("normal", "Text size", options = ["tiny", "small", "normal", "large"], group = gT)
showNum     = input.bool(true, "Price number above line", group = gT)
showDesc    = input.bool(true, "Description text", group = gT)
showProfile = input.bool(true, "GEX bars", group = gT)
profMax     = input.int(20, "GEX bar max length (bars)", minval = 3, group = gT)
barH        = input.float(0.12, "GEX bar thickness (price)", step = 0.02, group = gT)
fadeWeak    = input.bool(false, "Fade weaker GEX levels", group = gT)

gZ = "④ Zone & panel"
showChop  = input.bool(true, "Shade chop zone", group = gZ)
showRej   = input.bool(true, "Show reject zone (REJ line)", group = gZ)
showDash  = input.bool(true, "Show panel", group = gZ)
dashPosIn = input.string("Top Right", "Panel position", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = gZ)
priceTags = input.bool(false, "Tags on price scale", group = gZ)
dashSizeIn = input.string("large", "Panel text size", options = ["small", "normal", "large", "huge"], group = gZ)

gC = "⑤ Colors"
colR = input.color(#00e676, "Resistance / bull targets", group = gC)
colS = input.color(#ff1744, "Support / bear targets", group = gC)
colK = input.color(#00e5ff, "Key trigger", group = gC)
colT = input.color(#69f0ae, "Target-only", group = gC)
colX = input.color(#d500f9, "Reject zone", group = gC)
colZ = input.color(#00bcd4, "Chop zone shade", group = gC)

gTr = "⑥ Long / Short setups"
showTrades = input.bool(true, "Show long / short setups", group = gTr)
tradeStyle = input.string("Clean lines", "Setup style", options = ["Clean lines", "Boxes", "Panel only"], group = gTr)
colSL      = input.color(#ff9800, "Stop-loss line color", group = gTr)
slShow     = input.string("Only when trade is confirmed", "Show stop loss", options = ["Only when trade is confirmed", "Always"], group = gTr)
showSig    = input.bool(true, "Show LONG / SHORT / SL / TP markers", group = gTr)
sigToday   = input.bool(true, "Signals today only", group = gTr)
autoPlan = input.bool(true, "AUTO: entry = triggers, SL = level break, TP = next levels", group = gTr, tooltip = "LONG: entry = Bull trigger, SL = break of the next level BELOW entry, TP1/TP2 = next 2 levels above. SHORT: entry = Bear trigger, SL = break of the next level ABOVE entry, TP1/TP2 = next 2 levels below. Turn off to use the manual values below.")
slBuffer = input.float(0.05, "SL buffer past the level", step = 0.01, group = gTr)
slMode   = input.string("Candle close", "SL counts as hit on", options = ["Candle close", "Wick touch"], group = gTr)
longE   = input.float(737,   "Manual LONG entry", group = gTr)
longSL  = input.float(734.95, "Manual LONG stop loss", group = gTr)
longT1  = input.float(740,   "Manual LONG TP1", group = gTr)
longT2  = input.float(742,   "Manual LONG TP2", group = gTr)
shortE  = input.float(733,   "Manual SHORT entry", group = gTr)
shortSL = input.float(735.05, "Manual SHORT stop loss", group = gTr)
shortT1 = input.float(730,   "Manual SHORT TP1", group = gTr)
shortT2 = input.float(728,   "Manual SHORT TP2", group = gTr)

// ═════════ HELPERS ═════════
txtSize = switch txtSizeIn
    "tiny"   => size.tiny
    "normal" => size.normal
    "large"  => size.large
    => size.small
lStyle  = lStyleIn == "Dashed" ? line.style_dashed : lStyleIn == "Dotted" ? line.style_dotted : line.style_solid
dashSize = dashSizeIn == "small" ? size.small : dashSizeIn == "normal" ? size.normal : dashSizeIn == "huge" ? size.huge : size.large
dashPos = dashPosIn == "Bottom Right" ? position.bottom_right : dashPosIn == "Top Left" ? position.top_left : dashPosIn == "Bottom Left" ? position.bottom_left : position.top_right
CLEAR   = color.new(color.black, 100)

typeColor(string t) =>
    switch t
        "R" => colR
        "S" => colS
        "K" => colK
        "X" => colX
        => colT

fmtG(float g) =>
    (g > 0 ? "+" : "") + str.tostring(g, "#.##") + "M"

// ═════════ PARSE (once) ═════════
var array<float>  P = array.new<float>()
var array<string> T = array.new<string>()
var array<float>  G = array.new<float>()
var array<string> N = array.new<string>()
var float txtNet = na
var float txtHV  = na
var float rejLo  = na
var float rejHi  = na
var float kHi    = na
var float kLo    = na
if barstate.isfirst
    for row in str.split(levelsTxt, "\n")
        parts = str.split(row, "|")
        if parts.size() >= 2
            key = str.upper(str.trim(parts.get(0)))
            p = str.tonumber(key)
            if key == "NET"
                txtNet := str.tonumber(str.trim(parts.get(1)))
            else if key == "REJ" and parts.size() >= 3
                r1 = str.tonumber(str.trim(parts.get(1)))
                r2 = str.tonumber(str.trim(parts.get(2)))
                if not na(r1) and not na(r2)
                    rejLo := math.min(r1, r2) * mult
                    rejHi := math.max(r1, r2) * mult
            else if key == "HV"
                txtHV := str.tonumber(str.trim(parts.get(1)))
            else if not na(p)
                if str.upper(str.trim(parts.get(1))) == "K"
                    kHi := na(kHi) ? p * mult : math.max(kHi, p * mult)
                    kLo := na(kLo) ? p * mult : math.min(kLo, p * mult)
                P.push(p * mult)
                T.push(str.upper(str.trim(parts.get(1))))
                G.push(parts.size() >= 3 ? str.tonumber(str.trim(parts.get(2))) : na)
                N.push(parts.size() >= 4 ? str.trim(parts.get(3)) : "")

// ═════════ EFFECTIVE TRIGGERS (from Levels text) ═════════
bT     = not na(kHi) and kHi > kLo ? kHi : bullTrig * mult
sT     = not na(kLo) and kHi > kLo ? kLo : bearTrig * mult
netEff = na(txtNet) ? netGex : txtNet
volT   = na(txtHV) ? volTrig * mult : txtHV * mult

// ═════════ AUTO PLAN FROM LEVELS ═════════
var float aLBrk = na   // level whose break stops the long
var float aLT1  = na
var float aLT2  = na
var float aSBrk = na   // level whose break stops the short
var float aST1  = na
var float aST2  = na
if barstate.isfirst and P.size() > 0
    srt = P.copy()
    srt.sort(order.ascending)
    le = bT
    se = sT
    eps = syminfo.mintick / 2
    int nUpL = 0
    int nDnS = 0
    for p in srt
        if p < le - eps
            aLBrk := p
        if p > le + eps
            nUpL += 1
            if nUpL == 1
                aLT1 := p
            else if nUpL == 2
                aLT2 := p
        if p > se + eps and na(aSBrk)
            aSBrk := p
    for k = srt.size() - 1 to 0
        p = srt.get(k)
        if p < se - eps
            nDnS += 1
            if nDnS == 1
                aST1 := p
            else if nDnS == 2
                aST2 := p

// ═════════ TODAY'S RANGE ═════════
var int   dayStart = bar_index
var int   rthStart = na
var float dHi = high
var float dLo = low
if timeframe.change("D")
    dayStart := bar_index
    rthStart := na
    dHi := high
    dLo := low
else
    dHi := math.max(dHi, high)
    dLo := math.min(dLo, low)

if na(rthStart) and hour(time, "America/New_York") * 60 + minute(time, "America/New_York") >= 570
    rthStart := bar_index

isHit(float p) =>
    p > bT ? dHi >= p : p < sT ? dLo <= p : false

// ═════════ LONG / SHORT LOGIC ═════════
lE  = autoPlan ? bT : longE * mult
lSL = autoPlan and not na(aLBrk) ? aLBrk - slBuffer * mult : longSL * mult
lT1 = autoPlan and not na(aLT1) ? aLT1 : longT1 * mult
lT2 = autoPlan and not na(aLT2) ? aLT2 : autoPlan and not na(aLT1) ? aLT1 : longT2 * mult
sE  = autoPlan ? sT : shortE * mult
sSL = autoPlan and not na(aSBrk) ? aSBrk + slBuffer * mult : shortSL * mult
sT1 = autoPlan and not na(aST1) ? aST1 : shortT1 * mult
sT2 = autoPlan and not na(aST2) ? aST2 : autoPlan and not na(aST1) ? aST1 : shortT2 * mult
longStopped  = slMode == "Candle close" ? close < lSL : low <= lSL
shortStopped = slMode == "Candle close" ? close > sSL : high >= sSL
fmtR(float reward, float risk) =>
    risk > 0 ? "1:" + str.tostring(reward / risk, "#.#") : "—"

tz = "America/New_York"
isToday = dayofmonth(time, tz) == dayofmonth(timenow, tz) and month(time, tz) == month(timenow, tz) and year(time, tz) == year(timenow, tz)
canTrade = showTrades and (not sigToday or isToday)
lCross = ta.crossover(close, lE)
sCross = ta.crossunder(close, sE)

var int    pos = 0
var int    entryBar = na
var string status = "WAITING"
var color  stCol = color.gray
bool longSig  = false
bool shortSig = false
bool slHit    = false
bool tpHit    = false
if timeframe.change("D")
    pos := 0
    status := "WAITING"
    stCol := color.gray
if canTrade
    if pos == 1
        if longStopped
            slHit := true
            pos := 0
            status := "LONG · SL HIT ✗"
            stCol := #ff9800
        else if high >= lT2
            tpHit := true
            pos := 0
            status := "LONG · TP2 HIT ✓"
            stCol := colK
        else if high >= lT1
            status := "IN LONG · TP1 HIT ✓"
    else if pos == -1
        if shortStopped
            slHit := true
            pos := 0
            status := "SHORT · SL HIT ✗"
            stCol := #ff9800
        else if low <= sT2
            tpHit := true
            pos := 0
            status := "SHORT · TP2 HIT ✓"
            stCol := colK
        else if low <= sT1
            status := "IN SHORT · TP1 HIT ✓"
    if pos == 0 and not slHit and not tpHit
        if lCross
            pos := 1
            longSig := true
            entryBar := bar_index
            status := "IN LONG @ " + str.tostring(lE, "#.##")
            stCol := colR
        else if sCross
            pos := -1
            shortSig := true
            entryBar := bar_index
            status := "IN SHORT @ " + str.tostring(sE, "#.##")
            stCol := colS

// ═════════ PRICE-SCALE TAGS (optional) ═════════
lv(int i) => priceTags and P.size() > i ? P.get(i) : na
lc(int i) => P.size() > i ? typeColor(T.get(i)) : na
plot(lv(0),  "L1",  lc(0),  display = display.price_scale, editable = false)
plot(lv(1),  "L2",  lc(1),  display = display.price_scale, editable = false)
plot(lv(2),  "L3",  lc(2),  display = display.price_scale, editable = false)
plot(lv(3),  "L4",  lc(3),  display = display.price_scale, editable = false)
plot(lv(4),  "L5",  lc(4),  display = display.price_scale, editable = false)
plot(lv(5),  "L6",  lc(5),  display = display.price_scale, editable = false)
plot(lv(6),  "L7",  lc(6),  display = display.price_scale, editable = false)
plot(lv(7),  "L8",  lc(7),  display = display.price_scale, editable = false)
plot(lv(8),  "L9",  lc(8),  display = display.price_scale, editable = false)
plot(lv(9),  "L10", lc(9),  display = display.price_scale, editable = false)
plot(lv(10), "L11", lc(10), display = display.price_scale, editable = false)
plot(lv(11), "L12", lc(11), display = display.price_scale, editable = false)

// ═════════ DRAW ═════════
var array<line>  ls  = array.new<line>()
var array<label> lbs = array.new<label>()
var array<box>   bxs = array.new<box>()
var box chopBox = na
var box rejBox = na
var table dash = table.new(dashPos, 2, 7, bgcolor = color.new(#131722, 0), border_width = 1, border_color = color.new(#2a2e39, 0), frame_color = color.new(#434651, 0), frame_width = 2)
if barstate.isfirst
    table.merge_cells(dash, 0, 0, 1, 0)
    table.merge_cells(dash, 0, 1, 1, 1)
    table.merge_cells(dash, 0, 6, 1, 6)

cl(int r, string t, color tc) =>
    table.cell(dash, 0, r, t, text_color = tc, text_size = dashSize, text_halign = text.align_left)
cr(int r, string t, color tc) =>
    table.cell(dash, 1, r, t, text_color = tc, text_size = dashSize, text_halign = text.align_right)
f2(float x) => str.tostring(x, "#.##")

dots(int hit, int tot) =>
    string s = ""
    if tot > 0
        for k = 1 to tot
            s += k <= hit ? "●" : "○"
    s

row(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color = color.new(#9598a1, 0), text_size = dashSize, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = vc, text_size = dashSize, text_halign = text.align_right)

if barstate.islast
    for x in ls
        x.delete()
    ls.clear()
    for x in lbs
        x.delete()
    lbs.clear()
    for x in bxs
        x.delete()
    bxs.clear()
    chopBox.delete()
    rejBox.delete()

    float maxAbs = 0.0
    for g in G
        if not na(g)
            maxAbs := math.max(maxAbs, math.abs(g))

    x0    = startMode == "Full history" ? bar_index - 1 : startMode == "Today 9:30 open" and not na(rthStart) ? rthStart : dayStart
    ext   = startMode == "Full history" ? extend.left : extend.none
    xEnd  = bar_index + lineEnd
    barX0 = xEnd + 3

    float nUp = na
    float nDn = na
    int bullHit = 0
    int bullTot = 0
    int bearHit = 0
    int bearTot = 0

    if P.size() > 0
        for i = 0 to P.size() - 1
            p  = P.get(i)
            t  = T.get(i)
            g  = G.get(i)
            nm = N.get(i)
            hit = isHit(p)

            if p > bT
                bullTot += 1
                bullHit += hit ? 1 : 0
            if p < sT
                bearTot += 1
                bearHit += hit ? 1 : 0
            if p > close
                nUp := na(nUp) ? p : math.min(nUp, p)
            if p < close
                nDn := na(nDn) ? p : math.max(nDn, p)

            // strength-based fade: strongest GEX = full color, weak/no GEX = softer
            strength = na(g) or maxAbs == 0 ? 0.35 : math.abs(g) / maxAbs
            tr   = lTransp + (t != "K" and fadeWeak ? int(math.round((1 - strength) * fadeMax)) : 0)
            tr  := math.min(hit ? math.max(tr, hitFade) : tr, 90)
            c    = color.new(typeColor(t), tr)

            ls.push(line.new(x0, p, xEnd, p, extend = ext, color = c, width = t == "K" ? lwKey : lw, style = t == "T" ? line.style_dotted : lStyle))

            if showNum
                lbs.push(label.new(xEnd - 2, p, str.tostring(p, "#.##"), style = label.style_label_down, color = CLEAR, textcolor = c, size = txtSize))

            int descX = barX0
            if showProfile and not na(g) and maxAbs > 0
                len = math.max(2, int(math.round(math.abs(g) / maxAbs * profMax)))
                bxs.push(box.new(barX0, p + barH * mult, barX0 + len, p - barH * mult, border_width = 1, border_color = c, bgcolor = color.new(typeColor(t), math.min(tr + 15, 90))))
                descX := barX0 + len + 1

            if showDesc
                d = (hit ? "✓ " : "") + (na(g) ? "" : fmtG(g) + " / ") + nm
                lbs.push(label.new(descX, p, d, style = label.style_label_left, color = CLEAR, textcolor = c, size = txtSize))

    if showChop
        chopBox := box.new(x0, bT, xEnd, sT, border_width = 0, bgcolor = color.new(colZ, 93), extend = ext)
    if showRej and not na(rejLo)
        for edge in array.from(rejLo, rejHi)
            bool exists = false
            for q in P
                if math.abs(q - edge) < syminfo.mintick
                    exists := true
            if not exists
                ls.push(line.new(x0, edge, xEnd, edge, extend = ext, color = colX, width = 1, style = line.style_dashed))
        lbs.push(label.new(xEnd - 12, rejHi, "REJECT ZONE " + str.tostring(rejLo, "#.##") + "–" + str.tostring(rejHi, "#.##"), style = label.style_label_down, color = CLEAR, textcolor = colX, size = size.small))

    if showTrades and tradeStyle == "Boxes"
        bx1 = bar_index + 2
        bx2 = bar_index + math.max(lineEnd - 4, 8)
        bxs.push(box.new(bx1, lT2, bx2, lE, border_width = 1, border_color = color.new(colR, 40), bgcolor = color.new(colR, 82)))
        bxs.push(box.new(bx1, lE, bx2, lSL, border_width = 1, border_color = color.new(colS, 40), bgcolor = color.new(colS, 75)))
        bxs.push(box.new(bx1, sE, bx2, sT2, border_width = 1, border_color = color.new(colR, 40), bgcolor = color.new(colR, 82)))
        bxs.push(box.new(bx1, sSL, bx2, sE, border_width = 1, border_color = color.new(colS, 40), bgcolor = color.new(colS, 75)))

    if showTrades and tradeStyle == "Clean lines"
        sx1 = bar_index + 1
        sx2 = xEnd
        // stop-loss lines
        if slShow == "Always"
            ls.push(line.new(sx1, lSL, sx2, lSL, color = colSL, style = line.style_dashed, width = 1))
            ls.push(line.new(sx1, sSL, sx2, sSL, color = colSL, style = line.style_dashed, width = 1))
            lbs.push(label.new(sx1 + 1, lSL, "L-SL " + str.tostring(lSL, "#.##"), style = label.style_label_upper_left, color = CLEAR, textcolor = colSL, size = size.small))
            lbs.push(label.new(sx1 + 1, sSL, "S-SL " + str.tostring(sSL, "#.##"), style = label.style_label_lower_left, color = CLEAR, textcolor = colSL, size = size.small))
        else if pos != 0
            slP   = pos == 1 ? lSL : sSL
            entP  = pos == 1 ? lE : sE
            tpP   = pos == 1 ? lT1 : sT1
            ex0   = na(entryBar) ? bar_index : entryBar
            dir   = pos == 1 ? "LONG" : "SHORT"
            ptsR  = math.abs(entP - slP)
            ls.push(line.new(ex0, slP, sx2, slP, color = colSL, style = line.style_solid, width = 2))
            ls.push(line.new(ex0, entP, sx2, entP, color = color.new(color.white, 40), style = line.style_dotted, width = 1))
            lbs.push(label.new(sx1 + 1, slP, "✗ " + dir + " SL " + str.tostring(slP, "#.##") + "  (−" + str.tostring(ptsR, "#.##") + ")", style = pos == 1 ? label.style_label_upper_left : label.style_label_lower_left, color = colSL, textcolor = color.black, size = size.small))
            lbs.push(label.new(sx1 + 1, entP, dir + " entry " + str.tostring(entP, "#.##") + "  ·  TP1 " + str.tostring(tpP, "#.##"), style = pos == 1 ? label.style_label_lower_left : label.style_label_upper_left, color = CLEAR, textcolor = color.white, size = size.small))
        // small entry tags on trigger lines
        if pos == 0
            lbs.push(label.new(sx1 + 1, lE, "▲ LONG", style = label.style_label_lower_left, color = CLEAR, textcolor = colR, size = size.small))
            lbs.push(label.new(sx1 + 1, sE, "▼ SHORT", style = label.style_label_upper_left, color = CLEAR, textcolor = colS, size = size.small))

    if showDash
        inChop  = close >= sT and close <= bT
        bias    = close > bT ? "▲  BULLISH  ·  above " + f2(bT) : close < volT ? "▼  BEARISH  ·  HIGH VOL below " + f2(volT) : close < sT ? "▼  BEARISH  ·  below " + f2(sT) : "◆  CHOP " + f2(sT) + "–" + f2(bT) + "  ·  WAIT"
        biasCol = close > bT ? colR : close < sT ? colS : colK
        table.cell(dash, 0, 0, syminfo.ticker + "  ·  GEX PLAN", text_color = color.new(#d1d4dc, 0), bgcolor = color.new(#1e222d, 0), text_size = dashSize, text_halign = text.align_center)
        table.cell(dash, 0, 1, bias, text_color = inChop ? color.black : color.white, bgcolor = biasCol, text_size = dashSize, text_halign = text.align_center)
        cl(2, "▲ LONG  > " + f2(lE), colR)
        cr(2, "TP " + f2(lT1) + " · " + f2(lT2) + "    SL " + f2(lSL), color.new(#d1d4dc, 0))
        cl(3, "▼ SHORT < " + f2(sE), colS)
        cr(3, "TP " + f2(sT1) + " · " + f2(sT2) + "    SL " + f2(sSL), color.new(#d1d4dc, 0))
        cl(4, na(nUp) ? "↑ —" : "↑ " + f2(nUp) + "   +" + f2(nUp - close), colR)
        cr(4, na(nDn) ? "↓ —" : "↓ " + f2(nDn) + "   −" + f2(close - nDn), colS)
        cl(5, "Net GEX  " + fmtG(netEff), netEff < 0 ? colS : colR)
        cr(5, "Hits  ▲ " + str.tostring(bullHit) + "/" + str.tostring(bullTot) + "   ▼ " + str.tostring(bearHit) + "/" + str.tostring(bearTot), color.new(#9598a1, 0))
        table.cell(dash, 0, 6, "TRADE:  " + (showTrades ? status : "off"), text_color = color.white, bgcolor = color.new(stCol, 55), text_size = dashSize, text_halign = text.align_center)

// ═════════ ALERTS ═════════
alertcondition(ta.crossover(close, bT), "Bull trigger reclaimed", "Reclaimed bull trigger — bull targets in play")
alertcondition(ta.crossunder(close, sT), "Bear trigger lost", "Lost bear trigger — bear targets in play")
alertcondition(ta.crossunder(close, volT), "Below high-vol level", "Below high-vol level — expect bigger moves")

// ═════════ SIGNAL MARKERS ═════════
plotshape(showSig and longSig,  "LONG",  shape.labelup,   location.belowbar, colR, text = "LONG",  textcolor = color.black, size = size.small)
plotshape(showSig and shortSig, "SHORT", shape.labeldown, location.abovebar, colS, text = "SHORT", textcolor = color.white, size = size.small)
plotshape(showSig and slHit,    "SL",    shape.xcross,    location.abovebar, #ff9800, text = "SL", textcolor = #ff9800, size = size.small)
plotshape(showSig and tpHit,    "TP",    shape.diamond,   location.abovebar, colK, text = "TP", textcolor = colK, size = size.small)

alertcondition(longSig,  "LONG entry",  "LONG signal — reclaimed entry level")
alertcondition(shortSig, "SHORT entry", "SHORT signal — lost entry level")
alertcondition(slHit,    "Stop loss hit", "Stop loss hit")
alertcondition(tpHit,    "TP2 hit", "TP2 hit")
