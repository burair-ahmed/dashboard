# ITMatrixHQ GEX API Credentials
ITMATRIX_API_KEY=your_itmatrix_api_key_here
ITMATRIX_BASE_URL=https://api.itmatrixhq.com/v1

# Polling Interval (in seconds - respect your tier limits)
POLL_INTERVAL_SECONDS=60

# Cash-Futures Basis Mode: auto, manual, or none
CASH_FUTURES_BASIS_MODE=manual
MANUAL_ES_BASIS=15.0
MANUAL_NQ_BASIS=45.0

# Server Binding
HOST=127.0.0.1
PORT=8765

# Mock mode for testing without a live API key
USE_MOCK_DATA=true

