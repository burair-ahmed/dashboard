//@version=5
indicator("Sniper Reversal - GEX Confluence Companion", overlay=true)

// ==========================================
// INPUTS & CONFIGURATION
// ==========================================
string gex_input_string = input.string(
     defval="CW:5900.00|PW:5700.00|GF:5820.00|R:POS",
     title="GEX Compact String",
     tooltip="Paste the compact GEX string generated by the GEX backend or extension popup (Layer 3 fallback)"
     )

bool show_call_wall = input.bool(true, title="Show Call Wall", group="Display Settings")
bool show_put_wall  = input.bool(true, title="Show Put Wall", group="Display Settings")
bool show_flip      = input.bool(true, title="Show Gamma Flip", group="Display Settings")
bool show_labels    = input.bool(true, title="Show Price Labels", group="Display Settings")

color col_call_wall = input.color(color.new(#FF007F, 0), title="Call Wall Color", group="Color Styling")
color col_put_wall  = input.color(color.new(#00E676, 0), title="Put Wall Color", group="Color Styling")
color col_flip      = input.color(color.new(#FFD600, 0), title="Gamma Flip Color", group="Color Styling")

// ==========================================
// STRING PARSING ENGINE
// ==========================================
// Extracts numeric value following a token key like "CW:", "PW:", "GF:"
parse_token_float(string src, string key) =>
    float result = na
    int key_pos = str.pos(src, key)
    if not na(key_pos)
        int val_start = key_pos + str.length(key)
        string sub = str.substring(src, val_start)
        int pipe_pos = str.pos(sub, "|")
        string val_str = na(pipe_pos) ? sub : str.substring(sub, 0, pipe_pos)
        result := str.tonumber(val_str)
    result

// Extract Levels
float call_wall  = parse_token_float(gex_input_string, "CW:")
float put_wall   = parse_token_float(gex_input_string, "PW:")
float gamma_flip = parse_token_float(gex_input_string, "GF:")
bool is_positive_gamma = str.pos(gex_input_string, "R:POS") >= 0

// ==========================================
// PLOTTING NATIVE PINE LEVELS
// ==========================================
plot(show_call_wall and not na(call_wall) ? call_wall : na, 
     title="Call Wall (Dealer Resistance)", 
     color=col_call_wall, 
     linewidth=2, 
     style=plot.style_linebr)

plot(show_put_wall and not na(put_wall) ? put_wall : na, 
     title="Put Wall (Dealer Support)", 
     color=col_put_wall, 
     linewidth=2, 
     style=plot.style_linebr)

plot(show_flip and not na(gamma_flip) ? gamma_flip : na, 
     title="Gamma Flip Point", 
     color=col_flip, 
     linewidth=2, 
     style=plot.style_linebr)

// ==========================================
// CONFLUENCE SIGNALS FOR SNIPER ENGINE
// ==========================================
// Mean-reversion long bounce at Put Wall in Positive Gamma regime
bool put_wall_bounce = is_positive_gamma and not na(put_wall) and (low <= put_wall and close > put_wall)

// Mean-reversion short fade at Call Wall in Positive Gamma regime
bool call_wall_fade  = is_positive_gamma and not na(call_wall) and (high >= call_wall and close < call_wall)

// Gamma Regime Flip warning (accelerated volatility)
bool flip_breakdown  = not na(gamma_flip) and (close < gamma_flip and close[1] >= gamma_flip)

plotshape(put_wall_bounce, title="Put Wall Bounce (Long Confluence)", style=shape.triangleup, 
          location=location.belowbar, color=color.green, size=size.small, text="GEX PW Bounce")

plotshape(call_wall_fade, title="Call Wall Fade (Short Confluence)", style=shape.triangledown, 
          location=location.abovebar, color=color.red, size=size.small, text="GEX CW Fade")

// ==========================================
// ALERTS
// ==========================================
if put_wall_bounce
    alert("Sniper Reversal Alert: Put Wall Bounce detected at " + str.tostring(put_wall), alert.freq_once_per_bar_close)

if call_wall_fade
    alert("Sniper Reversal Alert: Call Wall Fade detected at " + str.tostring(call_wall), alert.freq_once_per_bar_close)

if flip_breakdown
    alert("GEX Warning: Price crossed below Gamma Flip (" + str.tostring(gamma_flip) + ") into High Volatility Regime", alert.freq_once_per_bar_close)

